MYUBER_ENV=development
MYUBER_RELEASE_VERSION=0.1.0
MYUBER_API_VERSION=v1
MYUBER_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
MYUBER_SECRET_KEY=change-me-to-a-long-random-development-secret
MYUBER_ADMIN_EMAIL=admin@myuber.local
MYUBER_ADMIN_PASSWORD=change-me-admin-password

# Leave empty for in-memory local state.
DATABASE_URL=
REDIS_URL=

MYUBER_SEED_DEMO_DATA=true
MYUBER_SEED_DEMO_RESET=false

ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

MYUBER_RATE_LIMIT_ENABLED=true
MYUBER_LOG_LEVEL=INFO
